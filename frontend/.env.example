# Server-only upstream used by the /backend same-origin rewrite.
# Production should set the API origin reachable from the Next.js server.
# Never rename this to NEXT_PUBLIC_BACKEND_URL or place secrets in this file.
BACKEND_URL=http://127.0.0.1:8000

# Public Cloudflare Turnstile widget key. Bind the production key to your app hostname.
# Local always-pass test sitekey: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
