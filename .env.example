# Runtime mode: development, test, or production.
APP_ENV=development
PUBLIC_SIGNUP_ENABLED=true

# PostgreSQL. Production must use a non-local host and sslmode=require or stronger.
DATABASE_URL=postgresql+psycopg2://app_user:replace_me@localhost:5432/app_db

# Browser/API origins. Production values must be HTTPS.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=development_only_insecure_secret_do_not_deploy
JWT_COOKIE_SECURE=false
JWT_EXPIRE_HOURS=24
JWT_ISSUER=hqlookup-api
JWT_AUDIENCE=hqlookup-web

# Managed production Redis should use rediss:// with credentials.
REDIS_URL=redis://localhost:6379/0

# LLM provider.
OPENAI_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral:7b
LLM_TIMEOUT_SECONDS=30
ASK_DEADLINE_SECONDS=120
MAX_LLM_CALLS_PER_REQUEST=10
MAX_LLM_PROMPT_CHARS=60000
MAX_LLM_OUTPUT_TOKENS=1500
MAX_INGESTED_CHUNK_CHARS=12000

# Production must point to a vetted, locally baked model directory. The
# development value keeps the existing Hugging Face model name for convenience.
EMBEDDING_MODEL_PATH=all-MiniLM-L6-v2

# Spreadsheet prompt/structure caps. Vision analysis is off when its model is blank.
MAX_SPREADSHEET_LLM_CHARS=60000
MAX_VISUALS_FOR_LLM=10
MAX_CHART_REFERENCE_CELLS=100000
MAX_TABLES_FROM_LLM=100
MAX_HEADERS_PER_TABLE=1000
MAX_FINDINGS_FROM_LLM=100
SPREADSHEET_LLM_MODEL=mistral:7b
SPREADSHEET_VISION_MODEL=

# Billing and transactional email. Use live-mode values only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
RESEND_API_KEY=
# Production must use a verified sender domain (not onboarding@resend.dev).
RESEND_FROM_EMAIL=Team <onboarding@resend.dev>

# Upload safety limits.
MAX_UPLOAD_FILES=10
MAX_UPLOAD_TOTAL_MB=50
MAX_ARCHIVE_UNCOMPRESSED_MB=50
MAX_ARCHIVE_COMPRESSION_RATIO=50

# Platform-assigned application port.
PORT=8000

# Exact reverse-proxy IP/CIDR values trusted to supply forwarding headers.
# Never use * on a publicly reachable API.
FORWARDED_ALLOW_IPS=127.0.0.1
