# Application runtime
# Use `production` in deployed environments. HOST and PORT are consumed by
# deployment commands; managed platforms commonly inject PORT automatically.
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Public browser origin and CORS policy. Separate multiple CORS origins with
# commas. Do not use `*` when browser credentials/cookies are enabled.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL + pgvector. Use sslmode=require when your provider requires TLS.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/ragproject
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800

# Authentication. Generate JWT_SECRET_KEY with: openssl rand -hex 32
# Production must use a new secret and JWT_COOKIE_SECURE=true.
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
# Leave blank for a host-only cookie. Only set this when intentionally sharing
# auth across trusted subdomains, e.g. .example.com.
JWT_COOKIE_DOMAIN=

# OpenAI-compatible LLM endpoint. For OpenAI use
# LLM_BASE_URL=https://api.openai.com/v1 and a secret OPENAI_API_KEY.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral:7b
SPREADSHEET_LLM_MODEL=mistral:7b
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Redis. Use rediss:// for a TLS-enabled managed service.
REDIS_URL=redis://localhost:6379/0

# Stripe (server-side secrets only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=HQLookup <noreply@example.com>

# Next.js API topology
# API_ORIGIN is server-only and is used by the Next.js reverse proxy.
# NEXT_PUBLIC_API_URL is embedded in browser assets and must never be a secret.
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_API_URL=/api
